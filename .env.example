# 复制为 .env 后按需修改，改完直接生效。
# 已有的系统环境变量优先级更高（临时覆盖：set DOUBAO_PORT=8899 后再启动）。

# ── 服务 ──
DOUBAO_HOST=127.0.0.1
DOUBAO_PORT=8787
# 留空 = 不校验（仅本机自用）
DOUBAO_API_KEY=

# ── 上游 ──
DOUBAO_CHAT_URL=https://www.doubao.com/chat/
# 豆包是国内服务，默认直连；必须走代理时才填，例如 http://127.0.0.1:7890
DOUBAO_PROXY=

# ── 浏览器 / 登录态 ──
# 登录一次即持久化，默认在用户目录下（~/.DouBao2.1API/browser）
DOUBAO_USER_DATA_DIR=
# 必须 false：人机验证（滑块/图片）需要人工点，headless 下没法处理
DOUBAO_HEADLESS=false
# 留空用 Playwright 自带 chromium；也可指向本地 Chrome/Edge
DOUBAO_BROWSER_EXECUTABLE=
# 第二个进程靠这个端口附加到已打开的浏览器（同一 profile 不能被两个进程共用）
DOUBAO_CDP_PORT=9333

# ── 调度与节流 ──
# 两次上游请求的最小间隔（秒）。实测连打 12 次即触发 710022004 限流，调小有风险
DOUBAO_MIN_INTERVAL=3.0
# 命中限流后的冷却（秒）：期间请求立即失败、不再打上游
DOUBAO_RATE_LIMIT_COOLDOWN=60
# 系统通知去重（秒）：连续失败不反复弹窗
DOUBAO_CAPTCHA_NOTIFY_COOLDOWN=300
DOUBAO_REQUEST_TIMEOUT=180
DOUBAO_FIRST_TOKEN_TIMEOUT=120
DOUBAO_NEW_CONVERSATION=true

# ── 模型 ──
# 三个 2.1 档位的真实标识已内置（见 registry.py），模板由 capture.bat 抓取
DOUBAO_DEFAULT_MODEL=doubao-2.1-turbo
# 需要覆写某个模型的 model_item_key 时（一般不用）：
# DOUBAO_MODEL_ID__doubao_2_1_pro=xxxx

# ── 多账号（仅预留，未实现切换）──
# 账号 = 一套 user-data-dir。同一时刻只跑一个 Chrome，换号就是换这两个变量再重启。
# 休眠的账号长期不用 cookie 可能过期，切回去要重新扫码。
DOUBAO_ACCOUNT_LABEL=default

# ── 额度查看（http://127.0.0.1:8787/admin）──
# 抓一次要新开标签页导航，实测约 7 秒，所以缓存 60 秒
DOUBAO_QUOTA_CACHE_TTL=60
DOUBAO_QUOTA_TIMEOUT=45
